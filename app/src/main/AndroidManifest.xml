<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kinh.protect">

    <!-- Quyền hệ thống và nền tảng -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- Giao diện chính -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình kiểm tra tính tương thích -->
        <activity
            android:name=".CompatibilityActivity"
            android:exported="false" />

        <!-- Màn hình Lab/Probe (Tùy chọn) -->
        <activity
            android:name=".LegacyMilletProbeActivity"
            android:exported="false" />

        <!-- Dịch vụ nền quản lý Aurogon allowlist -->
        <service
            android:name=".AurogonAllowlistService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Dịch vụ JobScheduler theo dõi thay đổi Millet URI -->
        <service
            android:name=".MilletWatchJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!-- Nhận sự kiện khởi động thiết bị để khôi phục dịch vụ -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Nhận tín hiệu làm mới alarm của Aurogon -->
        <receiver
            android:name=".AurogonRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kinh.protect.AUROGON_REFRESH_ALARM" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
